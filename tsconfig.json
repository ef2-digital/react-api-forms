{
  "include": ["src/react-api-form"],
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src/react-api-form",
    "noImplicitAny": true,
    "target": "es2018",
    "module": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
